{
  "theme": "base",
  "themeVariables": {
    "primaryColor": "#eff6ff",
    "primaryTextColor": "#1e3a8a",
    "primaryBorderColor": "#3b82f6",
    "lineColor": "#64748b",
    "secondaryColor": "#f0fdf4",
    "tertiaryColor": "#fef3c7",
    "fontFamily": "\"Microsoft YaHei\", \"SimHei\", sans-serif",
    "fontSize": "14px"
  },
  "flowchart": {
    "curve": "basis",
    "padding": 15,
    "nodeSpacing": 50,
    "rankSpacing": 60
  },
  "gantt": {
    "barHeight": 30,
    "barGap": 4,
    "topPadding": 30,
    "rightPadding": 30,
    "gridLineStartPadding": 30,
    "fontSize": 12,
    "todayMarkerStroke": "transparent",
    "todayMarkerStrokeWidth": 0
  }
}